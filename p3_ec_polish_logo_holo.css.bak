@keyframes p3-pedestal-breath {
    0%, 100% { opacity: 0.78; transform: translateX(-50%) scaleX(1.00); }
    50%      { opacity: 1.00; transform: translateX(-50%) scaleX(1.06); }
}
@media (prefers-reduced-motion: reduce) {
    .carousel-item.carousel-front::after { animation: none; }
}

/* ═══════════════════════════════════════════════════════
   2026-05-25 司「ロゴのホログラムもっとできない?」
   中央ロゴ (#bb-logo / .hologram-logo) を本物のホログラム投影に格上げ。
   既存の粒子・文字 brandanim は触らず、CSS overlay で additive に重ねる。
     - 虹のグロー呼吸 (cyan↔magenta を巡る drop-shadow)
     - 走査線 (scanline) を薄く重ねて「投影されてる」質感
     - 微浮遊 (float) で実体じゃなく像である感じ
     - 投影光のコーン (足元から立ち上る光)
   全 overlay は pointer-events:none (ロゴのクリック吸収を妨げない)。
   ═══════════════════════════════════════════════════════ */
.hologram-logo, #bb-logo {
    position: relative;
    animation: p3-holo-float 6s ease-in-out infinite;
    filter:
        drop-shadow(0 0 10px oklch(82% 0.15 200 / 0.45))
        drop-shadow(0 0 26px oklch(70% 0.20 285 / 0.30));
    will-change: transform, filter;
}
/* 虹グロー呼吸 (cyan→magenta→cyan) */
.hologram-logo { animation: p3-holo-float 6s ease-in-out infinite, p3-holo-glow 7.5s ease-in-out infinite; }
@keyframes p3-holo-glow {
    0%, 100% { filter: drop-shadow(0 0 10px oklch(82% 0.15 200 / 0.50)) drop-shadow(0 0 28px oklch(70% 0.20 285 / 0.28)); }
    50%      { filter: drop-shadow(0 0 12px oklch(80% 0.18 330 / 0.50)) drop-shadow(0 0 30px oklch(72% 0.18 200 / 0.30)); }
}
@keyframes p3-holo-float {
    0%, 100% { transform: translateY(0) scale(1.000); }
    50%      { transform: translateY(-5px) scale(1.012); }
}
/* 走査線 (hologram scanlines) — ロゴ上に薄く流れる */
.hologram-logo::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    pointer-events: none;
    background: repeating-linear-gradient(
        0deg,
        oklch(85% 0.12 200 / 0.05) 0px,
        oklch(85% 0.12 200 / 0.05) 1px,
        transparent 2px,
        transparent 4px
    );
    mix-blend-mode: plus-lighter;
    opacity: 0.6;
    animation: p3-holo-scan 5.5s linear infinite;
    border-radius: 10px;
    z-index: 2;
}
@keyframes p3-holo-scan {
    0%   { background-position: 0 0; }
    100% { background-position: 0 80px; }
}
/* 投影光のコーン (足元から立ち上る光 = 投影されてる証) */
.hologram-logo::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 56%;
    width: 150%;
    height: 220%;
    transform: translateX(-50%);
    pointer-events: none;
    background: conic-gradient(from 270deg at 50% 0%,
        transparent 78deg,
        oklch(82% 0.14 200 / 0.10) 90deg,
        transparent 102deg);
    filter: blur(6px);
    mix-blend-mode: plus-lighter;
    opacity: 0.55;
    z-index: -1;
    animation: p3-holo-cone 4.2s ease-in-out infinite;
}
@keyframes p3-holo-cone {
    0%, 100% { opacity: 0.40; }
    50%      { opacity: 0.62; }
}
/* テキストにわずかな色収差シマー (ホログラムのにじみ) */
.p6-logo-text {
    text-shadow:
        0.6px 0 0 oklch(70% 0.20 25 / 0.28),
       -0.6px 0 0 oklch(72% 0.18 200 / 0.28);
    animation: p3-holo-aberr 3.4s ease-in-out infinite;
}
@keyframes p3-holo-aberr {
    0%, 100% { text-shadow: 0.6px 0 0 oklch(70% 0.20 25 / 0.26), -0.6px 0 0 oklch(72% 0.18 200 / 0.26); }
    50%      { text-shadow: 1.1px 0 0 oklch(70% 0.20 25 / 0.32), -1.1px 0 0 oklch(72% 0.18 285 / 0.32); }
}
@media (prefers-reduced-motion: reduce) {
    .hologram-logo, #bb-logo, .hologram-logo::before, .hologram-logo::after, .p6-logo-text {
        animation: none !important;
    }
}

/* ═══════════════════════════════════════════════════════
   2026-05-25 司「④ ロゴ球連動」: 服を選ぶと中央ロゴ(コア)が共鳴
   p3_gravity_field.js が選択中に .hologram-logo へ .field-hot を付与。
   → ロゴのオーラが強く灯り、わずかに迫り出す = 「i が呼応する」。
   ═══════════════════════════════════════════════════════ */
.hologram-logo.field-hot {
    animation: p3-holo-float 6s ease-in-out infinite,
               p3-holo-glow-hot 2.2s ease-in-out infinite;
}
.hologram-logo.field-hot::after {
    opacity: 1;
    filter: blur(22px) saturate(1.9) brightness(1.25);
    transition: opacity .4s ease, filter .4s ease;
}
@keyframes p3-holo-glow-hot {
    0%, 100% { filter: drop-shadow(0 0 22px oklch(86% 0.22 200 / 0.85)) drop-shadow(0 0 56px oklch(74% 0.24 285 / 0.60)); }
    50%      { filter: drop-shadow(0 0 32px oklch(84% 0.24 330 / 0.90)) drop-shadow(0 0 72px oklch(76% 0.22 200 / 0.65)); }
}
@media (prefers-reduced-motion: reduce) {
    .hologram-logo.field-hot { animation: none; }
}

/* ═══════════════════════════════════════════════════════
   2026-05-30 司「ホログラムおかしい・下にして」
   原因: 3D点群ロゴが既存の卵PNG/白枠と重なって二重に見えていた。
   → 卵の殻PNG・古い3D球canvas・holo疑似枠を隠し、点群だけを主役に。
     さらにロゴ全体を少し下げて余白を作る。
   ═══════════════════════════════════════════════════════ */
/* 2026-05-30 司「ロゴ PNG に戻して」: 点群を OFF にしたので PNG/卵の
   隠し指定は撤去 (PNG をそのまま表示)。ロゴ下げだけ維持。 */
.hologram-logo {
    margin-top: 48px !important;
}

/* ═══════════════════════════════════════════════════════
   2026-05-30 司「ロゴ PNG に戻して」最終: このセッションで足した
   ホログラム追加効果 (走査線/虹オーラ/色収差/浮遊/グロー) を全部停止し、
   素の PNG ロゴに戻す。下げ (margin-top:48px) だけ維持。
   ═══════════════════════════════════════════════════════ */
.hologram-logo {
    animation: none !important;
    filter: none !important;
}
.hologram-logo::before,
.hologram-logo::after {
    content: none !important;
}
.p6-logo-text {
    text-shadow: none !important;
    animation: none !important;
}

/* 2026-05-30 司「PNG に戻して」: 点群を切った後、卵PNG が初期 opacity:0 の
   まま点灯せず見えなくなっていた。PNG (shell/sphere) を確実に表示。 */
.logo-holo-wrap .logo-shell,
.logo-holo-wrap .logo-sphere {
    opacity: 1 !important;
}

/* ═══════════════════════════════════════════════════════
   2026-05-30 司「コアの球を生きてる感じに」
   卵PNG はそのまま、中の i のコア球 (.logo-sphere) だけを脈動 + 虹に微変化。
   生命感: ゆっくり拡縮(呼吸) + hue回転(虹がよぎる) + 発光呼吸。
   ═══════════════════════════════════════════════════════ */
.logo-holo-wrap .logo-sphere {
    opacity: 1 !important;
    animation: p3-core-breath 4.2s ease-in-out infinite !important;
    transform-origin: 50% 33%;   /* コア球は卵の上部にある */
    will-change: transform, filter;
}
@keyframes p3-core-breath {
    0%, 100% {
        transform: scale(1.00);
        filter: drop-shadow(0 0 6px oklch(70% 0.20 270 / 0.55)) hue-rotate(0deg) saturate(1.05);
    }
    50% {
        transform: scale(1.07);
        filter: drop-shadow(0 0 14px oklch(75% 0.24 320 / 0.75)) hue-rotate(60deg) saturate(1.3);
    }
}
@media (prefers-reduced-motion: reduce) {
    .logo-holo-wrap .logo-sphere { animation: none !important; }
}
